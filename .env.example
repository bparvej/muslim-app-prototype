# Muslim Ummah - Environment Configuration Example
# Copy this file to .env and adjust the values as needed:
# cp .env.example .env

# Base Coordinates for Mosque Search and Prayer Times
# Example: 23°41'37.1"N 90°27'01.2"E (Jatrabari / Dania / Nurpur area, Dhaka)
BASE_LAT=23.693639
BASE_LNG=90.450333
BASE_LOCATION_NAME=যাত্রাবাড়ী/দনিয়া, ঢাকা

# Mosque Search Radius in kilometers (e.g. 1.0 for 1km radius)
MOSQUE_SEARCH_RADIUS_KM=1.0

# Prayer Calculation Method
# 1 = University of Islamic Sciences, Karachi (standard Hanafi method followed in Bangladesh)
# 2 = Islamic Society of North America (ISNA)
# 3 = Muslim World League (MWL)
# 4 = Umm Al-Qura University, Makkah
# 5 = Egyptian General Authority of Survey
PRAYER_CALC_METHOD=1

# External APIs (Free, No API key required)
PRAYER_API_BASE_URL=https://api.aladhan.com/v1
OSM_NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_API_URL=https://overpass-api.de/api/interpreter

